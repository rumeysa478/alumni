# ==============================================================================
# ALUMNI TRACKING SYSTEM - ÖRNEK ÇEVRESEL DEĞİŞKENLER (ENVIRONMENT VARIABLES)
# ==============================================================================
# Bu dosya tüm sistem değişkenlerinin şablonudur.
# Kullanmak için bu dosyayı kopyalayarak '.env' olarak kaydedin:
#   Windows (PowerShell): Copy-Item example.env .env
#   Linux / macOS:        cp example.env .env
#
# ⚠️ DİKKAT: .env dosyası hassas veriler (şifreler, anahtarlar) içerdiği için
# .gitignore ile korunmalıdır ve asla git reposuna commitlenmemelidir!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UYGULAMA VE SUNUCU AYARLARI (APPLICATION & SERVER)
# ------------------------------------------------------------------------------
# Çalışma ortamı: development | production | test
NODE_ENV=development

# Web sunucusunun dinleyeceği port numarası (Varsayılan: 5000)
PORT=5000

# CORS İzin Verilen Kaynaklar (* veya https://example.com)
CORS_ORIGIN=*

# Swagger Dokümantasyonunun Aktifliği (true / false)
SWAGGER_ENABLED=true


# ------------------------------------------------------------------------------
# 2. VERİTABANI BAĞLANTISI (POSTGRESQL DATABASE CONFIGURATION)
# ------------------------------------------------------------------------------
# Yerel (localhost) veya Docker servis adı (postgres_db)
DB_HOST=localhost

# PostgreSQL bağlantı portu (Standart port: 5432)
DB_PORT=5432

# PostgreSQL veritabanı kullanıcı adı
DB_USER=postgres

# PostgreSQL veritabanı kullanıcı şifresi (Güçlü bir şifre belirleyin)
DB_PASSWORD=your_secure_password

# Kullanılacak veritabanı adı
DB_NAME=alumni_db

# Tam Veritabanı Bağlantı URL'i (Prisma, Sequelize veya pg pool için)
# Lokal bağlantı örneği:
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/alumni_db

# Docker ortamındaki bağlantı URL'i:
# DATABASE_URL=postgresql://postgres:your_secure_password@postgres_db:5432/alumni_db


# ------------------------------------------------------------------------------
# 3. DOCKER POSTGRES SERVİSİ AYARLARI (DOCKER COMPOSE CONFIGURATION)
# ------------------------------------------------------------------------------
# Docker compose dosyasındaki resmi postgres:15-alpine imajı için değişkenler:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=alumni_db
PGDATA=/var/lib/postgresql/data/pgdata


# ------------------------------------------------------------------------------
# 4. GÜVENLİK VE JWT KİMLİK DOĞRULAMA (SECURITY & JWT AUTHENTICATION)
# ------------------------------------------------------------------------------
# JSON Web Token (JWT) imzalamak ve doğrulamak için gizli anahtar
# Üretimde en az 32 karakterden oluşan rastgele ve karmaşık bir değer kullanın!
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars

# JWT token geçerlilik süresi (örn: 15m, 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Bcrypt tuzlama tur sayısı (Bcrypt salt rounds)
BCRYPT_SALT_ROUNDS=10


# ------------------------------------------------------------------------------
# 5. DOSYA VE MEDYA YÜKLEME AYARLARI (FILE & MEDIA UPLOAD CONFIGURATION)
# ------------------------------------------------------------------------------
# Yüklenen dosyaların (CV, mezun profil resimleri) saklanacağı dizin
UPLOAD_DIR=./uploads

# İzin verilen maksimum dosya boyutu (Bayt cinsinden, varsayılan: 5MB = 5242880 bytes)
MAX_FILE_SIZE=5242880


# ------------------------------------------------------------------------------
# 6. LOGLAMA VE GELİŞTİRİCİ AYARLARI (LOGGING & DEBUGGING)
# ------------------------------------------------------------------------------
# Log seviyesi: debug | info | warn | error
LOG_LEVEL=info
