<%- include('../partials/header') %>

<div style="max-width: 840px; margin: 0 auto 3rem;">
  
  <!-- Back Link & Top Bar Actions -->
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> news bulletin &middot; Announcement Dossier
      </div>
      <a href="/announcements" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Duyuru Listesine Dön
      </a>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <a href="/announcements/<%= announcement.id %>/edit" class="pill-btn pill-yellow" style="font-size: 0.85rem;">
        ✏️ Duyuru Bilgilerini Düzenle
      </a>
      <form action="/announcements/<%= announcement.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
        <button type="submit" class="pill-btn btn-danger" style="font-size: 0.85rem; padding: 0.45rem 1rem;">
          🗑️ Sil
        </button>
      </form>
    </div>
  </div>

  <!-- Announcement Card (Substack Long-form Layout) -->
  <article class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-hover); overflow: hidden;">
    
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.5rem 2.25rem;">
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <% if (announcement.category === 'EVENT') { %>
          <span class="badge badge-event">🎉 Etkinlik</span>
        <% } else if (announcement.category === 'CAREER') { %>
          <span class="badge badge-career">💼 Kariyer</span>
        <% } else if (announcement.category === 'ACADEMIC') { %>
          <span class="badge badge-academic">📚 Akademik</span>
        <% } else { %>
          <span class="badge badge-general">📢 Genel</span>
        <% } %>

        <% if (announcement.target_audience === 'ALUMNI') { %>
          <span class="badge badge-alumni">Mezunlar</span>
        <% } else if (announcement.target_audience === 'STUDENT') { %>
          <span class="badge badge-student">Öğrenciler</span>
        <% } else { %>
          <span class="badge badge-verified">Herkes</span>
        <% } %>

        <% if (announcement.is_active) { %>
          <span class="badge badge-active">✓ Yayında</span>
        <% } else { %>
          <span class="badge badge-inactive">Taslak</span>
        <% } %>
      </div>

      <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-stone-neutral);">
        ID: #<%= announcement.id %> &bull; Duyuru Detayı (Read - R)
      </div>
    </div>

    <div class="card-body" style="padding: 2.5rem 2.25rem;">
      
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; line-height: 1.2; color: var(--color-forest-abyss); margin-bottom: 1rem;">
        <%= announcement.title %>
      </h1>

      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--color-ash-hairline); color: var(--color-stone-neutral); font-size: 0.9rem; flex-wrap: wrap;">
        <span style="font-family: var(--font-mono); font-weight: 600; color: var(--color-forest-abyss);">
          🏛️ <%= announcement.author_name || 'İstanbul Üniversitesi Rektörlüğü' %>
        </span>
        &bull;
        <span style="font-family: var(--font-mono);">
          <%= announcement.published_at ? new Date(announcement.published_at).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) : '18 Kasım 2026' %>
        </span>
      </div>

      <!-- Long-form content in editorial serif (Substack style) -->
      <div style="font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.8; color: var(--color-warm-ink); white-space: pre-line;">
        <%= announcement.content %>
      </div>

    </div>

    <div style="background: #fbfcfb; border-top: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 2.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="/announcements" class="pill-btn" style="font-size: 0.85rem;">
        &larr; Tüm Duyuruları Gör
      </a>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/events" class="pill-btn pill-yellow" style="font-size: 0.85rem;">
          📅 İlgili Etkinlikler
        </a>
      </div>
    </div>

  </article>

</div>

<%- include('../partials/footer') %>
