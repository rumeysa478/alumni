<%- include('../partials/header') %>

<div style="max-width: 800px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <a href="/announcements" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Duyuru Listesine Dön
      </a>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 800; color: #111; margin-top: 0.75rem;">
        <%= announcement.title %>
      </h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Duyuru Detayı (Read - R) &bull; ID: #<%= announcement.id %>
      </p>
    </div>

    <div style="display: flex; gap: 0.5rem;">
      <a href="/announcements/<%= announcement.id %>/edit" class="pill-btn pill-peach">
        ✏️ Duyuru Bilgilerini Düzenle
      </a>
      <form action="/announcements/<%= announcement.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
        <button type="submit" class="pill-btn" style="background: #fee2e2; color: #b91c1c; border-color: #f87171;">
          🗑️ Sil
        </button>
      </form>
    </div>
  </div>

  <div class="card" style="border: 2px solid var(--connext-border); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.06);">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border);">
      <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <% if (announcement.category === 'EVENT') { %>
          <span class="badge badge-event">🎉 Etkinlik</span>
        <% } else if (announcement.category === 'CAREER') { %>
          <span class="badge badge-career">💼 Kariyer</span>
        <% } else if (announcement.category === 'ACADEMIC') { %>
          <span class="badge badge-academic">📚 Akademik</span>
        <% } else { %>
          <span class="badge badge-general">📢 Genel</span>
        <% } %>

        <% if (announcement.target_audience === 'ALUMNI') { %>
          <span class="badge badge-alumni">Mezunlar</span>
        <% } else if (announcement.target_audience === 'STUDENT') { %>
          <span class="badge badge-student">Öğrenciler</span>
        <% } else { %>
          <span class="badge badge-verified">Herkes</span>
        <% } %>

        <% if (announcement.is_active) { %>
          <span class="badge badge-active">Yayında</span>
        <% } else { %>
          <span class="badge badge-inactive">Taslak</span>
        <% } %>
      </div>

      <div style="font-size: 0.85rem; color: var(--text-muted);">
        Yayınlayan: <strong><%= announcement.author || 'Sistem' %></strong>
      </div>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <div style="color: #1e293b; font-size: 1.05rem; line-height: 1.8; white-space: pre-line; margin-bottom: 2rem;">
        <%= announcement.content %>
      </div>

      <div style="padding-top: 1.5rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <span style="font-size: 0.85rem; color: var(--text-muted);">
          Yayın Tarihi: <strong><%= announcement.published_at ? new Date(announcement.published_at).toLocaleString('tr-TR') : '-' %></strong>
        </span>
        <a href="/api/announcements/<%= announcement.id %>" target="_blank" class="pill-btn" style="font-size: 0.8rem; padding: 0.25rem 0.75rem;">
          JSON API Uç Noktası ↗
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
