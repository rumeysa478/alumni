<%- include('../partials/header') %>

<div style="max-width: 750px; margin: 0 auto 3rem;">
  <div style="margin-bottom: 1.5rem;">
    <div class="parenthetical-eyebrow">
      <span>(Y)our</span> event organizer &middot; Create Event
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; color: var(--color-forest-abyss); margin: 0;">
        📅 Yeni Etkinlik Oluştur (Create)
      </h1>
      <a href="/events" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Tüm Etkinliklere Dön
      </a>
    </div>
    <p style="color: var(--color-warm-ink); font-size: 0.95rem; margin-top: 0.4rem;">
      İstanbul Üniversitesi mezunları ve öğrencileri için buluşma, seminer veya panel organize edin.
    </p>
  </div>

  <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-hover);">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-voltage-lime); border: 1.5px solid var(--color-forest-abyss);"></div>
        <div style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--color-forest-abyss);">
          Etkinlik Bilgileri
        </div>
      </div>
      <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-stone-neutral);">
        * Zorunlu Alanlar
      </div>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-error" style="margin-bottom: 1.5rem;">
          ⚠ <%= errorMessage %>
        </div>
      <% } %>

      <form action="/events" method="POST">
        
        <div class="form-group">
          <label class="form-label" for="title">Etkinlik Başlığı *</label>
          <input
            type="text"
            id="title"
            name="title"
            class="form-control"
            placeholder="Örn: 2026 Geleneksel Mezunlar Günü"
            value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
            required
          >
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="event_date">Etkinlik Tarihi ve Saati *</label>
            <input
              type="datetime-local"
              id="event_date"
              name="event_date"
              class="form-control"
              value="<%= typeof formData !== 'undefined' && formData.event_date ? formData.event_date : '' %>"
              required
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="capacity">Kontenjan (Kişi)</label>
            <input
              type="number"
              id="capacity"
              name="capacity"
              class="form-control"
              placeholder="100"
              value="<%= typeof formData !== 'undefined' && formData.capacity ? formData.capacity : '100' %>"
            >
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="location">Yer / Lokasyon</label>
            <input
              type="text"
              id="location"
              name="location"
              class="form-control"
              placeholder="Örn: Beyazıt Rektörlük Mavi Salon / Online"
              value="<%= typeof formData !== 'undefined' && formData.location ? formData.location : '' %>"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="organizer_id">Düzenleyen Kullanıcı</label>
            <input
              type="number"
              id="organizer_id"
              name="organizer_id"
              class="form-control"
              placeholder="1"
              value="<%= typeof formData !== 'undefined' && formData.organizer_id ? formData.organizer_id : '1' %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Etkinlik Açıklaması ve Programı</label>
          <textarea
            id="description"
            name="description"
            rows="5"
            class="form-control"
            placeholder="Etkinliğin amacı, konuşmacılar, program akışı ve kayıt koşulları..."
          ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
          <a href="/events" class="pill-btn" style="background: var(--color-mist-surface);">İptal</a>
          <button type="submit" class="pill-btn pill-lime">
            ✓ Etkinliği Oluştur
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
