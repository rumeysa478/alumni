<%- include('../partials/header') %>

<div style="max-width: 860px; margin: 0 auto 3rem;">
  
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> campus gathering &middot; Event Dossier
      </div>
      <a href="/events" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Tüm Etkinliklere Dön
      </a>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <a href="/events/<%= event.id %>/edit" class="pill-btn pill-yellow" style="font-size: 0.85rem;">
        ✏️ Etkinliği Düzenle
      </a>
      <form action="/events/<%= event.id %>/delete" method="POST" onsubmit="return confirm('Bu etkinliği silmek istediğinize emin misiniz?');" style="display: inline;">
        <button type="submit" class="pill-btn btn-danger" style="font-size: 0.85rem; padding: 0.45rem 1rem;">
          🗑️ Sil
        </button>
      </form>
    </div>
  </div>

  <% 
    const dateObj = event.event_date ? new Date(event.event_date) : new Date();
    const formattedDate = dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase();
    const formattedTime = dateObj.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
  %>

  <div class="card" style="border: 2px solid var(--color-forest-abyss); box-shadow: var(--shadow-card-hover); border-radius: var(--radius-xl); overflow: hidden; margin-bottom: 2rem;">
    
    <!-- Header -->
    <div style="padding: 1.25rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid var(--color-ash-hairline); background: #ffffff;">
      <div style="display: flex; align-items: center; gap: 0.85rem;">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--color-voltage-lime); color: var(--color-forest-abyss); border: 1.5px solid var(--color-forest-abyss); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight: 800;">
          🎓
        </div>
        <div>
          <div style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--color-forest-abyss);">
            <%= creator ? (creator.first_name + ' ' + creator.last_name) : 'İstanbul Üniversitesi Mezunlar Temsilcisi' %>
          </div>
          <div style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-stone-neutral);">
            <%= creator ? (creator.department || 'İstanbul Üniversitesi') : 'CONNEXT Organizasyon Heyeti' %>
          </div>
        </div>
      </div>

      <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-stone-neutral);">
        ID: #<%= event.id %>
      </div>
    </div>

    <!-- Cyber Emerald Aurora Poster Banner -->
    <div style="background: radial-gradient(at 75% 35%, #7af3ff 0%, #d3fb52 40%, #005b38 85%, #052326 100%); padding: 3.5rem 2rem; text-align: center; border-bottom: 1.5px solid var(--color-forest-abyss); color: #ffffff;">
      <h1 style="font-family: var(--font-display); font-size: 3rem; font-weight: 900; line-height: 1.1; letter-spacing: -0.01em; color: #ffffff; text-transform: uppercase; margin: 0 0 1.5rem 0; text-shadow: 0 2px 8px rgba(0,0,0,0.4);">
        <%= event.title %>
      </h1>

      <div style="display: flex; justify-content: center; align-items: center; gap: 1.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 1.05rem; font-weight: 700; color: var(--color-voltage-lime); text-shadow: 0 1px 3px rgba(0,0,0,0.5);">
        <div>📅 <%= formattedDate %></div>
        <div>🕒 <%= formattedTime %></div>
        <div>📍 <%= (event.location || 'İSTANBUL ÜNİVERSİTESİ BEYAZIT KAMPÜSÜ').toUpperCase() %></div>
      </div>

      <div style="font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: #e2e8f0; letter-spacing: 0.08em; text-transform: uppercase;">
        TÜM MEZUN VE ÖĞRENCİLERİMİZİ BEKLİYORUZ
      </div>
    </div>

    <!-- Body Details -->
    <div style="padding: 2.25rem;">
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> event itinerary &middot; Agenda
      </div>
      <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--color-forest-abyss); margin-bottom: 0.75rem;">
        Etkinlik Hakkında &amp; Program Akışı
      </h3>
      <div style="font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.8; color: var(--color-warm-ink); white-space: pre-line; margin-bottom: 2rem;">
        <%= event.description %>
      </div>

      <!-- Registration Box -->
      <div style="background: #fbfcfb; border: 1.5px solid var(--color-ash-hairline); border-radius: 14px; padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
        <div>
          <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-stone-neutral); text-transform: uppercase;">Kontenjan Durumu</div>
          <div style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--color-forest-abyss); margin-top: 0.2rem;">
            <%= attendees ? attendees.length : 0 %> / <%= event.capacity || '100' %> Katılımcı Kayıtlı
          </div>
        </div>

        <form action="/api/events/<%= event.id %>/register" method="POST" style="margin: 0;">
          <input type="hidden" name="user_id" value="1">
          <button type="submit" class="pill-btn pill-lime" style="padding: 0.6rem 1.6rem; font-size: 0.95rem;">
            🎟️ Etkinliğe Kaydol &rarr;
          </button>
        </form>
      </div>

    </div>

  </div>

  <!-- Attendees List -->
  <% if (typeof attendees !== 'undefined' && attendees && attendees.length > 0) { %>
    <div class="card" style="border: 1.5px solid var(--connext-border);">
      <div class="card-header" style="background: #ffffff;">
        <div style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--color-forest-abyss);">
          Kayıtlı Katılımcılar (<%= attendees.length %>)
        </div>
      </div>
      <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Katılımcı</th>
                <th>E-Posta</th>
                <th>Bölüm</th>
                <th>Kayıt Tarihi</th>
              </tr>
            </thead>
            <tbody>
              <% attendees.forEach(att => { %>
                <tr>
                  <td>
                    <strong><%= att.first_name %> <%= att.last_name %></strong>
                  </td>
                  <td style="font-family: var(--font-mono); font-size: 0.86rem; color: var(--color-univ-emerald);">
                    <%= att.email %>
                  </td>
                  <td style="font-size: 0.88rem;">
                    <%= att.department || 'Management Information Systems' %>
                  </td>
                  <td style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-stone-neutral);">
                    <%= att.registered_at ? new Date(att.registered_at).toLocaleDateString('tr-TR') : '-' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

</div>

<%- include('../partials/footer') %>
