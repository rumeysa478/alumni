<%- include('../partials/header') %>

<div style="max-width: 700px; margin: 0 auto;">
  <div style="margin-bottom: 1.5rem;">
    <a href="/users" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
      &larr; Kullanıcı Listesine Dön
    </a>
    <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 800; color: #111; margin-top: 0.75rem;">
      ➕ Yeni Kullanıcı Kaydı (Create)
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      CONNEXT &bull; İstanbul Üniversitesi Mezun ve Öğrenci Ağına Yeni Profil Ekleme
    </p>
  </div>

  <div class="card" style="border: 2px solid var(--connext-border); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.06);">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border); padding: 1.25rem 2rem;">
      <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; font-weight: 800; color: #111;">Kullanıcı Bilgileri</div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">* Zorunlu Alanlar</div>
    </div>
    <div class="card-body" style="padding: 2rem;">
      <form action="/users" method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="first_name">Ad</label>
            <input
              type="text"
              id="first_name"
              name="first_name"
              class="form-control"
              placeholder="Örn: Rumeysa"
              value="<%= typeof formData !== 'undefined' && formData.first_name ? formData.first_name : '' %>"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="last_name">Soyad</label>
            <input
              type="text"
              id="last_name"
              name="last_name"
              class="form-control"
              placeholder="Örn: Aydın"
              value="<%= typeof formData !== 'undefined' && formData.last_name ? formData.last_name : '' %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">E-Posta Adresi *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="form-control"
            placeholder="ornek@alumni.iu.edu.tr"
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          >
          <div class="form-text">Benzersiz bir kurumsal veya kişisel e-posta adresi giriniz.</div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Şifre *</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="form-control"
            placeholder="En az 6 karakterli güçlü bir şifre"
          >
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="role">Sistem Rolü *</label>
            <select id="role" name="role" class="form-select" required>
              <option value="ALUMNI" <%= typeof formData !== 'undefined' && formData.role === 'ALUMNI' ? 'selected' : '' %>>ALUMNI (Mezun)</option>
              <option value="STUDENT" <%= typeof formData !== 'undefined' && formData.role === 'STUDENT' ? 'selected' : '' %>>STUDENT (Öğrenci)</option>
              <option value="ADMIN" <%= typeof formData !== 'undefined' && formData.role === 'ADMIN' ? 'selected' : '' %>>ADMIN (Yönetici)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="graduation_year">Mezuniyet Yılı</label>
            <input
              type="number"
              id="graduation_year"
              name="graduation_year"
              class="form-control"
              placeholder="Örn: 2024"
              min="1950"
              max="2035"
              value="<%= typeof formData !== 'undefined' && formData.graduation_year ? formData.graduation_year : '' %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="department">Bölüm / Program</label>
          <input
            type="text"
            id="department"
            name="department"
            class="form-control"
            placeholder="Örn: Management Information Systems (YBS)"
            value="<%= typeof formData !== 'undefined' && formData.department ? formData.department : '' %>"
          >
        </div>

        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
          <button type="submit" class="pill-btn pill-pink" style="font-size: 0.95rem; padding: 0.6rem 1.75rem;">
            ✓ Kullanıcıyı Kaydet
          </button>
          <a href="/users" class="pill-btn">İptal</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
