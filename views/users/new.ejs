<%- include('../partials/header') %>

<div style="max-width: 720px; margin: 0 auto 3rem;">
  <div style="margin-bottom: 1.5rem;">
    <div class="parenthetical-eyebrow">
      <span>(Y)our</span> alumni registration &middot; Enrollment Desk
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; color: var(--color-forest-abyss); margin: 0;">
        ➕ Yeni Kullanıcı Kaydı (Create)
      </h1>
      <a href="/users" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Kullanıcı Listesine Dön
      </a>
    </div>
    <p style="color: var(--color-warm-ink); font-size: 0.95rem; margin-top: 0.4rem;">
      CONNEXT &bull; İstanbul Üniversitesi Mezun ve Öğrenci Ağına Yeni Profil Ekleme
    </p>
  </div>

  <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-hover);">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-voltage-lime); border: 1.5px solid var(--color-forest-abyss);"></div>
        <div style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--color-forest-abyss);">
          Kullanıcı Bilgileri
        </div>
      </div>
      <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-stone-neutral);">
        * Zorunlu Alanlar
      </div>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <form action="/users" method="POST">
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="first_name">Ad</label>
            <input
              type="text"
              id="first_name"
              name="first_name"
              class="form-control"
              placeholder="Örn: Rumeysa"
              value="<%= typeof formData !== 'undefined' && formData.first_name ? formData.first_name : '' %>"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="last_name">Soyad</label>
            <input
              type="text"
              id="last_name"
              name="last_name"
              class="form-control"
              placeholder="Örn: Aydın"
              value="<%= typeof formData !== 'undefined' && formData.last_name ? formData.last_name : '' %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">E-Posta Adresi *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="form-control"
            placeholder="ornek@alumni.iu.edu.tr"
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          >
          <div class="form-text">Benzersiz bir kurumsal veya kişisel e-posta adresi giriniz.</div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Şifre *</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="form-control"
            placeholder="En az 6 karakterli güvenli şifre"
          >
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="role">Sistem Rolü *</label>
            <select id="role" name="role" class="form-select" required>
              <option value="ALUMNI" <%= typeof formData !== 'undefined' && formData.role === 'ALUMNI' ? 'selected' : '' %>>ALUMNI (Mezun)</option>
              <option value="STUDENT" <%= typeof formData !== 'undefined' && formData.role === 'STUDENT' ? 'selected' : '' %>>STUDENT (Öğrenci)</option>
              <option value="ADMIN" <%= typeof formData !== 'undefined' && formData.role === 'ADMIN' ? 'selected' : '' %>>ADMIN (Yönetici)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="graduation_year">Mezuniyet / Giriş Yılı</label>
            <input
              type="number"
              id="graduation_year"
              name="graduation_year"
              class="form-control"
              placeholder="2024"
              min="1950"
              max="2035"
              value="<%= typeof formData !== 'undefined' && formData.graduation_year ? formData.graduation_year : '2024' %>"
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="department">Akademik Bölüm</label>
          <input
            type="text"
            id="department"
            name="department"
            class="form-control"
            placeholder="Örn: Management Information Systems"
            value="<%= typeof formData !== 'undefined' && formData.department ? formData.department : 'Management Information Systems' %>"
          >
        </div>

        <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
          <a href="/users" class="pill-btn" style="background: var(--color-mist-surface);">İptal</a>
          <button type="submit" class="pill-btn pill-lime">
            ✓ Kullanıcıyı Kaydet
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
