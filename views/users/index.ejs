<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 800; color: #111;">🎓 Mezun ve Öğrenci Listesi</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">CONNEXT Mezun Ağı &bull; İstanbul Üniversitesi Kayıtlı Öğrenci & Mezun Rehberi</p>
  </div>
  <div style="display: flex; gap: 0.75rem;">
    <a href="/users/new" class="pill-btn pill-pink">
      <span>➕</span> Yeni Kullanıcı Ekle
    </a>
    <a href="/api/users" target="_blank" class="pill-btn">
      <span>⚡</span> REST API (JSON)
    </a>
  </div>
</div>

<!-- Filtreleme ve Arama Kartı (Photo 2 inspired) -->
<div class="card" style="margin-bottom: 1.5rem; border: 1.5px solid var(--connext-border);">
  <div class="card-body" style="padding: 1.25rem 1.5rem;">
    <form action="/users" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div style="flex: 2; min-width: 220px;">
        <label class="form-label" for="search">İsim, E-posta veya Bölüm Ara</label>
        <input
          type="text"
          id="search"
          name="search"
          class="form-control"
          placeholder="Örn: Rumeysa, Bilgisayar, info@..."
          value="<%= filters && filters.search ? filters.search : '' %>"
        >
      </div>

      <div style="flex: 1; min-width: 150px;">
        <label class="form-label" for="role">Rol Filtrele</label>
        <select id="role" name="role" class="form-select">
          <option value="">Tümü</option>
          <option value="ALUMNI" <%= filters && filters.role === 'ALUMNI' ? 'selected' : '' %>>ALUMNI (Mezun)</option>
          <option value="STUDENT" <%= filters && filters.role === 'STUDENT' ? 'selected' : '' %>>STUDENT (Öğrenci)</option>
          <option value="ADMIN" <%= filters && filters.role === 'ADMIN' ? 'selected' : '' %>>ADMIN (Yönetici)</option>
        </select>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="pill-btn pill-peach">Filtrele</button>
        <% if (filters && (filters.search || filters.role || filters.department)) { %>
          <a href="/users" class="pill-btn">Temizle</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Kullanıcılar Tablosu / Listesi -->
<div class="card" style="border: 1.5px solid var(--connext-border);">
  <div class="card-header" style="border-bottom: 1.5px solid var(--connext-border); background: #ffffff;">
    <div style="font-weight: 700; color: #1e293b; font-family: 'Playfair Display', Georgia, serif; font-size: 1.2rem;">
      Kayıtlı Kullanıcılar (<%= users ? users.length : 0 %>)
    </div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">
      Toplam: <%= users ? users.length : 0 %> profil
    </div>
  </div>

  <div class="card-body" style="padding: 0;">
    <% if (users && users.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Ad Soyad</th>
              <th>E-Posta</th>
              <th>Bölüm</th>
              <th>Rol</th>
              <th>Durum</th>
              <th style="text-align: right;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td style="font-weight: 700; color: #64748b;">#<%= u.id %></td>
                <td>
                  <a href="/users/<%= u.id %>" style="color: #111; font-weight: 700; text-decoration: none; font-family: 'Playfair Display', Georgia, serif; font-size: 1.05rem;">
                    <%= u.first_name %> <%= u.last_name %>
                  </a>
                </td>
                <td>
                  <a href="mailto:<%= u.email %>" style="color: #2563eb; text-decoration: none; font-size: 0.9rem;">
                    <%= u.email %>
                  </a>
                </td>
                <td style="font-size: 0.9rem; color: #334155;">
                  <%= u.department || 'Management Information Systems' %>
                </td>
                <td>
                  <% if (u.role === 'ALUMNI') { %>
                    <span class="badge badge-alumni">ALUMNI</span>
                  <% } else if (u.role === 'STUDENT') { %>
                    <span class="badge badge-student">STUDENT</span>
                  <% } else if (u.role === 'ADMIN') { %>
                    <span class="badge badge-admin">ADMIN</span>
                  <% } else { %>
                    <span class="badge"><%= u.role %></span>
                  <% } %>
                </td>
                <td>
                  <% if (u.is_verified) { %>
                    <span class="badge badge-verified">✓ Onaylı</span>
                  <% } else { %>
                    <span class="badge badge-unverified">Beklemede</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 0.4rem;">
                    <a href="/users/<%= u.id %>" class="pill-btn pill-peach" style="padding: 0.2rem 0.65rem; font-size: 0.8rem;">
                      Profil ↗
                    </a>
                    <a href="/users/<%= u.id %>/edit" class="pill-btn" style="padding: 0.2rem 0.65rem; font-size: 0.8rem;">
                      Düzenle
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
        <p style="font-size: 1.1rem; margin-bottom: 1rem;">Arama kriterlerine uygun kullanıcı bulunamadı.</p>
        <a href="/users" class="pill-btn">Tüm Kullanıcıları Listele</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
