<%- include('../partials/header') %>

<div style="max-width: 960px; margin: 0 auto 3rem;">
  
  <!-- Back Link & Top Bar Actions -->
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> alumni dossier &middot; Profile Detail
      </div>
      <a href="/users" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Kullanıcı Listesine Dön
      </a>
    </div>

    <div style="display: flex; gap: 0.6rem; align-items: center;">
      <a href="/users/<%= user.id %>/edit" class="pill-btn pill-yellow" style="font-size: 0.85rem;">
        ✏️ Bilgilerini Düzenle
      </a>
      <form action="/users/<%= user.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Bu kullanıcıyı kalıcı olarak silmek istediğinize emin misiniz?');">
        <button type="submit" class="pill-btn btn-danger" style="font-size: 0.85rem; padding: 0.45rem 1rem;">
          🗑️ Sil
        </button>
      </form>
    </div>
  </div>

  <!-- CONNEXT Profile Command Center Card -->
  <div class="card" style="border: 2px solid var(--color-forest-abyss); box-shadow: var(--shadow-card-hover); border-radius: var(--radius-xl); overflow: hidden; margin-bottom: 2rem;">
    
    <!-- Top Header Row: Avatar, Name, Verified Emblem -->
    <div style="padding: 2.25rem 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; border-bottom: 1.5px solid var(--color-ash-hairline); background: #ffffff;">
      <div style="display: flex; align-items: center; gap: 1.5rem;">
        <div style="width: 84px; height: 84px; border-radius: 50%; border: 2.5px solid var(--color-forest-abyss); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; background: var(--color-voltage-lime); color: var(--color-forest-abyss); flex-shrink: 0; box-shadow: 0 4px 12px rgba(211, 251, 82, 0.4);">
          👤
        </div>
        <div>
          <h1 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 900; color: var(--color-forest-abyss); display: flex; align-items: center; gap: 0.5rem; line-height: 1.1; margin: 0;">
            <%= user.first_name %> <%= user.last_name %>
            <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--color-forest-abyss); color: var(--color-voltage-lime); font-size: 0.72rem; font-family: var(--font-mono); font-weight: 800;">Cn</span>
          </h1>
          <div style="font-size: 0.88rem; color: var(--color-stone-neutral); margin-top: 0.45rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <span style="font-family: var(--font-mono); font-weight: 700;">Profil ID: #<%= user.id %></span> &bull; 
            <% if (user.role === 'ALUMNI') { %>
              <span class="badge badge-alumni">ALUMNI (Mezun)</span>
            <% } else if (user.role === 'STUDENT') { %>
              <span class="badge badge-student">STUDENT (Öğrenci)</span>
            <% } else if (user.role === 'ADMIN') { %>
              <span class="badge badge-admin">ADMIN (Yönetici)</span>
            <% } else { %>
              <span class="badge"><%= user.role %></span>
            <% } %>

            <% if (user.is_verified) { %>
              <span class="badge badge-verified">✓ Onaylı Profil</span>
            <% } else { %>
              <span class="badge badge-unverified">Onay Bekliyor</span>
            <% } %>
          </div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="border: 1.5px solid var(--color-forest-abyss); background: var(--color-mist-surface); padding: 0.45rem 0.95rem; border-radius: 9999px; font-family: var(--font-display); font-weight: 900; font-size: 1.1rem; letter-spacing: 0.12em; display: flex; align-items: center; gap: 0.4rem;">
          🏛️ CONNEXT
        </div>
      </div>
    </div>

    <!-- Contact & Meta Strip -->
    <div style="padding: 1rem 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; border-bottom: 1.5px solid var(--color-ash-hairline); background: #fbfcfb; font-size: 0.92rem;">
      <div style="display: flex; gap: 1.75rem; flex-wrap: wrap;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">E-Posta:</span>
          <strong style="margin-left: 0.35rem; color: var(--color-forest-abyss);"><%= user.email %></strong>
        </div>
        <div>
          <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">Bölüm:</span>
          <strong style="margin-left: 0.35rem; color: var(--color-forest-abyss);"><%= user.department || 'Management Information Systems' %></strong>
        </div>
        <div>
          <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">Dönem / Yıl:</span>
          <strong style="margin-left: 0.35rem; color: var(--color-forest-abyss);"><%= user.graduation_year || '2024' %></strong>
        </div>
      </div>
      <div>
        <a href="mailto:<%= user.email %>" class="pill-btn pill-lime" style="padding: 0.35rem 0.95rem; font-size: 0.82rem;">
          ✉️ İletişime Geç
        </a>
      </div>
    </div>

    <!-- Interactive Pill Matrix (School style 15-button matrix) -->
    <div style="padding: 1.5rem 2.5rem; border-bottom: 1.5px solid var(--color-ash-hairline); background: #ffffff;">
      <div style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--color-stone-neutral); text-transform: uppercase; margin-bottom: 0.75rem; letter-spacing: 0.05em;">
        Hızlı Profil Menüsü &middot; Quick Actions
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <span class="pill-btn pill-lime" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">+ follow</span>
        <span class="pill-btn pill-yellow" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">send DM</span>
        <span class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">cv &middot; resume</span>
        <span class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">skills</span>
        <span class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">experience</span>
        <span class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">education</span>
        <a href="/jobs" class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">referral jobs</a>
        <a href="/events" class="pill-btn" style="font-size: 0.8rem; padding: 0.3rem 0.85rem;">events</a>
      </div>
    </div>

    <!-- Bio / Information Block -->
    <div style="padding: 2.25rem 2.5rem;">
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> biography &middot; Overview
      </div>
      <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--color-forest-abyss); margin-bottom: 0.75rem;">
        Hakkında &amp; Kariyer Özeti
      </h3>
      <p style="color: var(--color-warm-ink); line-height: 1.7; font-size: 0.98rem; max-width: 780px;">
        İstanbul Üniversitesi bünyesinde yetişmiş, mezunlar ağı CONNEXT üzerinde aktif bir topluluk üyesidir. Kariyer fırsatları, teknik işbirlikleri ve öğrenci mentorluğu konularında destek vermektedir.
      </p>

      <div style="margin-top: 1.75rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <div style="padding: 1rem; border-radius: 12px; background: #f8faf8; border: 1px solid var(--color-ash-hairline);">
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-stone-neutral); text-transform: uppercase;">Üyelik Tarihi</div>
          <div style="font-weight: 700; color: var(--color-forest-abyss); margin-top: 0.25rem;">
            <%= user.created_at ? new Date(user.created_at).toLocaleDateString('tr-TR') : '2026' %>
          </div>
        </div>

        <div style="padding: 1rem; border-radius: 12px; background: #f8faf8; border: 1px solid var(--color-ash-hairline);">
          <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-stone-neutral); text-transform: uppercase;">Ağ Durumu</div>
          <div style="font-weight: 700; color: var(--color-univ-emerald); margin-top: 0.25rem;">
            ● Aktif &amp; Ulaşılabilir
          </div>
        </div>
      </div>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>
