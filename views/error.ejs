<%- include('./partials/header') %>

<div class="card" style="max-width: 600px; margin: 3.5rem auto; text-align: center; padding: 2.5rem 2rem; border: 2px solid var(--connext-border); border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.06);">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">⚠️</div>
  <h2 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem; color: #111;"><%= typeof title !== 'undefined' ? title : 'Bir Hata Oluştu' %></h2>
  <p style="color: #64748b; font-size: 1rem; margin-bottom: 1.75rem;"><%= typeof message !== 'undefined' ? message : 'İstediğiniz sayfa veya işlem gerçekleştirilemedi.' %></p>
  <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/users" class="pill-btn pill-peach">Kullanıcı Listesine Dön</a>
    <a href="/" class="pill-btn">Ana Sayfa</a>
  </div>
</div>

<%- include('./partials/footer') %>
