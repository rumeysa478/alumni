<%- include('../partials/header') %>

<div style="max-width: 1040px; margin: 0 auto 3rem;">
  
  <!-- Back Link & Top Bar Actions -->
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> application dossier &middot; Candidate Review
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.35rem;">
        <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; color: var(--color-forest-abyss); margin: 0;">
          Başvuru #<%= application.id %>
        </h1>
        <span class="badge" style="background: var(--color-voltage-lime); color: var(--color-forest-abyss); font-weight: 800; font-size: 0.85rem;">
          <%= application.status %>
        </span>
      </div>
      <p style="color: var(--color-stone-neutral); font-size: 0.88rem; font-family: var(--font-mono); margin-top: 0.25rem;">
        Başvuru Tarihi: <%= new Date(application.applied_at).toLocaleString('tr-TR') %>
      </p>
    </div>

    <div style="display: flex; gap: 0.6rem; align-items: center;">
      <a href="/applications" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Tüm Başvurular
      </a>
      <a href="/api/applications/<%= application.id %>" target="_blank" class="pill-btn" style="font-family: var(--font-mono); font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        <span>⚡</span> JSON API
      </a>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1.1fr; gap: 1.75rem; align-items: start;">
    
    <!-- Left Column: Application Details & Candidate Dossier -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      
      <!-- Job & Applicant Summary Card -->
      <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card);">
        <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 2rem;">
          <div style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--color-forest-abyss);">
            Pozisyon &amp; Aday Özeti
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-stone-neutral);">
            Eşleşme Kaydı
          </div>
        </div>

        <div class="card-body" style="padding: 2rem;">
          
          <!-- Job Info -->
          <% if (application.job) { %>
            <div style="margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--color-ash-hairline);">
              <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">Başvurulan Pozisyon</span>
              <h2 style="font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--color-forest-abyss); margin: 0.25rem 0;">
                <a href="/jobs/<%= application.job.id %>" style="color: var(--color-forest-abyss); text-decoration: none;">
                  <%= application.job.title %>
                </a>
              </h2>
              <div style="color: var(--color-warm-ink); font-size: 0.95rem;">
                🏢 <strong><%= application.job.company %></strong> &bull; 📍 <%= application.job.location || 'İstanbul / Remote' %>
              </div>
            </div>
          <% } %>

          <!-- Applicant Info -->
          <% if (application.applicant) { %>
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--color-ash-hairline);">
              <div style="width: 54px; height: 54px; border-radius: 50%; background: var(--color-canary-yellow); color: var(--color-forest-abyss); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; border: 1.5px solid var(--color-forest-abyss);">
                👤
              </div>
              <div>
                <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">Aday Bilgisi</span>
                <div style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--color-forest-abyss);">
                  <%= application.applicant.first_name %> <%= application.applicant.last_name %>
                </div>
                <div style="font-size: 0.86rem; color: var(--color-stone-neutral);">
                  <%= application.applicant.email %> &bull; <%= application.applicant.department || 'Management Information Systems' %>
                </div>
              </div>
            </div>
          <% } %>

          <!-- Financial & Compensation Details -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            <div style="padding: 1rem; border-radius: 12px; background: #f8faf8; border: 1px solid var(--color-ash-hairline);">
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-stone-neutral); text-transform: uppercase;">Beklenen Aylık Maaş</div>
              <div style="font-family: var(--font-mono); font-size: 1.25rem; font-weight: 800; color: var(--color-univ-emerald); margin-top: 0.25rem;">
                <% if (application.expected_salary) { %>
                  <%= Number(application.expected_salary).toLocaleString('tr-TR') %> <%= application.currency || 'TRY' %>
                <% } else { %>
                  Belirtilmedi
                <% } %>
              </div>
            </div>

            <div style="padding: 1rem; border-radius: 12px; background: #f8faf8; border: 1px solid var(--color-ash-hairline);">
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-stone-neutral); text-transform: uppercase;">Başvuru Modeli</div>
              <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; color: var(--color-forest-abyss); margin-top: 0.25rem;">
                N:M Web MVC
              </div>
            </div>
          </div>

          <!-- Cover letter / Niyet mektubu -->
          <div>
            <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); text-transform: uppercase;">Ön Yazı / Niyet Mektubu (Cover Letter)</span>
            <div style="font-family: var(--font-serif); font-size: 1.05rem; line-height: 1.7; color: var(--color-warm-ink); background: #fbfcfb; border: 1px solid var(--color-ash-hairline); border-radius: 12px; padding: 1.25rem; margin-top: 0.4rem; white-space: pre-line;">
              <%= application.cover_letter || 'Aday bu başvuru için özel bir ön yazı eklemedi.' %>
            </div>
          </div>

          <!-- Documents / Links -->
          <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <% if (application.resume_url) { %>
              <a href="<%= application.resume_url %>" target="_blank" class="pill-btn pill-yellow" style="font-size: 0.82rem;">
                📄 CV / Özgeçmiş Görüntüle ↗
              </a>
            <% } %>
            <% if (application.portfolio_url) { %>
              <a href="<%= application.portfolio_url %>" target="_blank" class="pill-btn" style="font-size: 0.82rem;">
                🌐 Portfolyo / GitHub ↗
              </a>
            <% } %>
          </div>

        </div>
      </div>

    </div>

    <!-- Right Column: Status Pipeline Control & Actions -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      
      <!-- Status Management Form -->
      <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card);">
        <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 1.5rem;">
          <div style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--color-forest-abyss);">
            Durum Yönetimi
          </div>
        </div>
        <div class="card-body" style="padding: 1.5rem;">
          <form action="/applications/<%= application.id %>/status" method="POST">
            <div class="form-group">
              <label class="form-label" for="status" style="font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase;">
                Yeni Aşama / Durum Seç
              </label>
              <select id="status" name="status" class="form-select" required>
                <option value="PENDING" <%= application.status === 'PENDING' ? 'selected' : '' %>>⏳ Beklemede (PENDING)</option>
                <option value="REVIEWING" <%= application.status === 'REVIEWING' ? 'selected' : '' %>>👀 İnceleniyor (REVIEWING)</option>
                <option value="INTERVIEW" <%= application.status === 'INTERVIEW' ? 'selected' : '' %>>🎯 Mülakat (INTERVIEW)</option>
                <option value="OFFERED" <%= application.status === 'OFFERED' ? 'selected' : '' %>>💌 Teklif Yapıldı (OFFERED)</option>
                <option value="ACCEPTED" <%= application.status === 'ACCEPTED' ? 'selected' : '' %>>✅ Kabul Edildi (ACCEPTED)</option>
                <option value="REJECTED" <%= application.status === 'REJECTED' ? 'selected' : '' %>>❌ Reddedildi (REJECTED)</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="notes" style="font-family: var(--font-mono); font-size: 0.8rem; text-transform: uppercase;">
                Değerlendirme Notu
              </label>
              <textarea id="notes" name="notes" rows="3" class="form-control" placeholder="Aday hakkında iç notlar..."><%= application.notes || '' %></textarea>
            </div>

            <button type="submit" class="pill-btn pill-lime" style="width: 100%;">
              ✓ Durumu Güncelle
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Danger Actions -->
      <div class="card" style="border: 1px solid var(--color-ash-hairline); border-radius: var(--radius-lg);">
        <div class="card-body" style="padding: 1.25rem;">
          <div style="font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: var(--color-stone-neutral); text-transform: uppercase; margin-bottom: 0.75rem;">
            Başvuru İşlemleri
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.6rem;">
            <form action="/applications/<%= application.id %>/withdraw" method="POST" onsubmit="return confirm('Başvuruyu geri çekmek istediğinize emin misiniz?');">
              <button type="submit" class="pill-btn" style="width: 100%; font-size: 0.82rem; background: var(--color-mist-surface);">
                ↩️ Başvuruyu Geri Çek (Withdraw)
              </button>
            </form>
            <form action="/applications/<%= application.id %>/delete" method="POST" onsubmit="return confirm('Bu başvuru kaydını tamamen silmek istediğinize emin misiniz?');">
              <button type="submit" class="pill-btn btn-danger" style="width: 100%; font-size: 0.82rem;">
                🗑️ Kaydı Tamamen Sil
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>
