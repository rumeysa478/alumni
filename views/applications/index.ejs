<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 800; color: #111;">📝 İş ve Staj Başvuruları</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">CONNEXT &bull; Aday Değerlendirme Takibi ve Başvuru Durum Yönetimi</p>
  </div>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/applications/new" class="pill-btn pill-pink">
      <span>➕</span> Yeni Başvuru Yap
    </a>
    <a href="/jobs" class="pill-btn pill-peach">
      <span>💼</span> İlanlara Git
    </a>
    <a href="/api/applications" target="_blank" class="pill-btn">
      <span>⚡</span> REST API (JSON)
    </a>
  </div>
</div>

<%
  const totalApps = applications ? applications.length : 0;
  let pendingCount = 0;
  let reviewingCount = 0;
  let interviewCount = 0;
  let offeredAcceptedCount = 0;

  if (applications) {
    applications.forEach(a => {
      if (a.status === 'PENDING') pendingCount++;
      else if (a.status === 'REVIEWING') reviewingCount++;
      else if (a.status === 'INTERVIEW') interviewCount++;
      else if (a.status === 'OFFERED' || a.status === 'ACCEPTED') offeredAcceptedCount++;
    });
  }
%>

<!-- CONNEXT İstatistik Özet Şeridi (Pill Cards) -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
  <a href="/applications" style="text-decoration: none;">
    <div class="card" style="padding: 1rem; text-align: center; border: 1.5px solid var(--connext-border); border-left: 5px solid #111827; margin-bottom: 0;">
      <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700;">TOPLAM BAŞVURU</div>
      <div style="font-size: 1.6rem; font-weight: 900; color: #111; margin-top: 0.2rem;"><%= totalApps %></div>
    </div>
  </a>
  <a href="/applications?status=PENDING" style="text-decoration: none;">
    <div class="card" style="padding: 1rem; text-align: center; border: 1.5px solid var(--connext-border); border-left: 5px solid #f59e0b; margin-bottom: 0;">
      <div style="font-size: 0.78rem; color: #92400e; font-weight: 700;">⏳ BEKLEMEDE</div>
      <div style="font-size: 1.6rem; font-weight: 900; color: #b45309; margin-top: 0.2rem;"><%= pendingCount %></div>
    </div>
  </a>
  <a href="/applications?status=REVIEWING" style="text-decoration: none;">
    <div class="card" style="padding: 1rem; text-align: center; border: 1.5px solid var(--connext-border); border-left: 5px solid #3b82f6; margin-bottom: 0;">
      <div style="font-size: 0.78rem; color: #1e40af; font-weight: 700;">👀 İNCELENİYOR</div>
      <div style="font-size: 1.6rem; font-weight: 900; color: #1d4ed8; margin-top: 0.2rem;"><%= reviewingCount %></div>
    </div>
  </a>
  <a href="/applications?status=INTERVIEW" style="text-decoration: none;">
    <div class="card" style="padding: 1rem; text-align: center; border: 1.5px solid var(--connext-border); border-left: 5px solid #ec4899; margin-bottom: 0;">
      <div style="font-size: 0.78rem; color: #be185d; font-weight: 700;">🎯 MÜLAKAT</div>
      <div style="font-size: 1.6rem; font-weight: 900; color: #be185d; margin-top: 0.2rem;"><%= interviewCount %></div>
    </div>
  </a>
  <a href="/applications?status=OFFERED" style="text-decoration: none;">
    <div class="card" style="padding: 1rem; text-align: center; border: 1.5px solid var(--connext-border); border-left: 5px solid #10b981; margin-bottom: 0;">
      <div style="font-size: 0.78rem; color: #065f46; font-weight: 700;">💌 TEKLİF / KABUL</div>
      <div style="font-size: 1.6rem; font-weight: 900; color: #047857; margin-top: 0.2rem;"><%= offeredAcceptedCount %></div>
    </div>
  </a>
</div>

<!-- Filtreleme Kartı -->
<div class="card" style="margin-bottom: 1.5rem; border: 1.5px solid var(--connext-border);">
  <div class="card-body" style="padding: 1.25rem 1.5rem;">
    <form action="/applications" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 170px;">
        <label class="form-label" for="status">Durum Filtrele</label>
        <select id="status" name="status" class="form-select">
          <option value="">Tüm Durumlar</option>
          <option value="PENDING" <%= filters && filters.status === 'PENDING' ? 'selected' : '' %>>⏳ PENDING (Beklemede)</option>
          <option value="REVIEWING" <%= filters && filters.status === 'REVIEWING' ? 'selected' : '' %>>👀 REVIEWING (İnceleniyor)</option>
          <option value="INTERVIEW" <%= filters && filters.status === 'INTERVIEW' ? 'selected' : '' %>>🎯 INTERVIEW (Mülakat)</option>
          <option value="OFFERED" <%= filters && filters.status === 'OFFERED' ? 'selected' : '' %>>💌 OFFERED (Teklif Yapıldı)</option>
          <option value="ACCEPTED" <%= filters && filters.status === 'ACCEPTED' ? 'selected' : '' %>>🎉 ACCEPTED (Kabul Edildi)</option>
          <option value="REJECTED" <%= filters && filters.status === 'REJECTED' ? 'selected' : '' %>>❌ REJECTED (Reddedildi)</option>
        </select>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="pill-btn pill-peach">Filtrele</button>
        <% if (filters && (filters.status || filters.job_id || filters.user_id)) { %>
          <a href="/applications" class="pill-btn">Temizle</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Başvurular Tablosu -->
<div class="card" style="border: 1.5px solid var(--connext-border); border-radius: 16px;">
  <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border); padding: 1.25rem 1.75rem;">
    <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; font-weight: 800; color: #111;">
      Kayıtlı Başvurular (<%= totalApps %>)
    </div>
  </div>

  <div class="card-body" style="padding: 0;">
    <% if (applications && applications.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Aday Bilgisi</th>
              <th>İlan & Şirket</th>
              <th>Beklenen Maaş</th>
              <th>Durum</th>
              <th>Tarih</th>
              <th style="text-align: right;">Aksiyonlar</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr>
                <td style="font-weight: 700; color: #64748b;">#<%= app.id %></td>
                <td>
                  <a href="/users/<%= app.user_id %>" style="color: #111; font-weight: 700; text-decoration: none; font-family: 'Playfair Display', Georgia, serif; font-size: 1.05rem;">
                    <%= app.first_name || ('Kullanıcı #' + app.user_id) %> <%= app.last_name || '' %>
                  </a>
                  <div style="font-size: 0.8rem; color: #64748b;"><%= app.email || '' %></div>
                </td>
                <td>
                  <a href="/jobs/<%= app.job_id %>" style="color: #2563eb; font-weight: 600; text-decoration: none;">
                    <%= app.job_title || ('İlan #' + app.job_id) %>
                  </a>
                  <div style="font-size: 0.8rem; color: #64748b;"><%= app.company || '' %></div>
                </td>
                <td>
                  <% if (app.expected_salary) { %>
                    <span style="font-weight: 700; color: #047857;">💰 <%= Number(app.expected_salary).toLocaleString('tr-TR') %> TRY</span>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Belirtilmedi</span>
                  <% } %>
                </td>
                <td>
                  <% if (app.status === 'PENDING') { %>
                    <span class="badge" style="background-color: #fef3c7; color: #92400e;">⏳ Beklemede</span>
                  <% } else if (app.status === 'REVIEWING') { %>
                    <span class="badge" style="background-color: #dbeafe; color: #1e40af;">👀 İnceleniyor</span>
                  <% } else if (app.status === 'INTERVIEW') { %>
                    <span class="badge" style="background-color: #fce7f3; color: #9d174d;">🎯 Mülakat</span>
                  <% } else if (app.status === 'OFFERED') { %>
                    <span class="badge" style="background-color: #ede9fe; color: #5b21b6;">💌 Teklif</span>
                  <% } else if (app.status === 'ACCEPTED') { %>
                    <span class="badge badge-active">🎉 Kabul</span>
                  <% } else if (app.status === 'REJECTED') { %>
                    <span class="badge badge-inactive">❌ Reddedildi</span>
                  <% } else { %>
                    <span class="badge"><%= app.status %></span>
                  <% } %>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted);">
                  <%= app.created_at ? new Date(app.created_at).toLocaleDateString('tr-TR') : '-' %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; gap: 0.4rem;">
                    <a href="/applications/<%= app.id %>" class="pill-btn pill-peach" style="font-size: 0.8rem; padding: 0.2rem 0.65rem;">
                      İncele ↗
                    </a>
                    
                    <form action="/applications/<%= app.id %>/status" method="POST" style="display: inline;">
                      <input type="hidden" name="status" value="<%= app.status === 'PENDING' ? 'REVIEWING' : (app.status === 'REVIEWING' ? 'INTERVIEW' : 'OFFERED') %>">
                      <button type="submit" class="pill-btn pill-pink" style="font-size: 0.8rem; padding: 0.2rem 0.65rem;" title="Sonraki Aşamaya Geç">
                        &rarr; İlerle
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
        <p style="font-size: 1.1rem; margin-bottom: 1rem;">Seçilen kriterde başvuru kaydı bulunamadı.</p>
        <a href="/applications" class="pill-btn">Tüm Başvuruları Göster</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
