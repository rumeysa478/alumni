<%- include('../partials/header') %>

<!-- Top Hero & Eyebrow Row -->
<div style="margin-bottom: 2rem;">
  <div class="parenthetical-eyebrow">
    <span>(Y)our</span> applicant pipeline &middot; Applications Manager
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-family: var(--font-display); font-size: 2.4rem; font-weight: 900; color: var(--color-forest-abyss); line-height: 1.15; margin: 0;">
        📝 İş ve Staj Başvuruları
      </h1>
      <p style="color: var(--color-warm-ink); font-size: 1rem; margin-top: 0.4rem;">
        CONNEXT &bull; Aday değerlendirme havuzu, mülakat durumları ve başvuru takibi
      </p>
    </div>
    <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
      <a href="/applications/new" class="pill-btn pill-lime">
        <span>➕</span> Yeni Başvuru Yap
      </a>
      <a href="/jobs" class="pill-btn pill-yellow">
        <span>💼</span> İlanlara Git
      </a>
      <a href="/api/applications" target="_blank" class="pill-btn" style="font-family: var(--font-mono); font-size: 0.82rem;">
        <span>⚡</span> REST API (JSON)
      </a>
    </div>
  </div>
</div>

<%
  const totalApps = applications ? applications.length : 0;
  let pendingCount = 0;
  let reviewingCount = 0;
  let interviewCount = 0;
  let acceptedCount = 0;

  if (applications) {
    applications.forEach(a => {
      if (a.status === 'PENDING') pendingCount++;
      else if (a.status === 'REVIEWING') reviewingCount++;
      else if (a.status === 'INTERVIEW') interviewCount++;
      else if (a.status === 'ACCEPTED' || a.status === 'OFFERED') acceptedCount++;
    });
  }
%>

<!-- SpatialChat 2x4 Metric Pipeline Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
  <a href="/applications" style="text-decoration: none;">
    <div class="card" style="padding: 1.25rem; text-align: center; border: 1.5px solid var(--connext-border); border-top: 4px solid var(--color-forest-abyss); margin-bottom: 0;">
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-stone-neutral); font-weight: 700;">TOPLAM BAŞVURU</div>
      <div style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--color-forest-abyss); margin-top: 0.2rem;"><%= totalApps %></div>
    </div>
  </a>

  <a href="/applications?status=PENDING" style="text-decoration: none;">
    <div class="card" style="padding: 1.25rem; text-align: center; border: 1.5px solid var(--connext-border); border-top: 4px solid var(--color-canary-yellow); margin-bottom: 0;">
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: #854d0e; font-weight: 700;">⏳ BEKLEMEDE</div>
      <div style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: #854d0e; margin-top: 0.2rem;"><%= pendingCount %></div>
    </div>
  </a>

  <a href="/applications?status=REVIEWING" style="text-decoration: none;">
    <div class="card" style="padding: 1.25rem; text-align: center; border: 1.5px solid var(--connext-border); border-top: 4px solid var(--color-forest-abyss); margin-bottom: 0;">
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-forest-abyss); font-weight: 700;">👀 İNCELENİYOR</div>
      <div style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--color-forest-abyss); margin-top: 0.2rem;"><%= reviewingCount %></div>
    </div>
  </a>

  <a href="/applications?status=INTERVIEW" style="text-decoration: none;">
    <div class="card" style="padding: 1.25rem; text-align: center; border: 1.5px solid var(--connext-border); border-top: 4px solid var(--color-voltage-lime); margin-bottom: 0;">
      <div style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--color-univ-emerald); font-weight: 700;">🎯 MÜLAKAT</div>
      <div style="font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: var(--color-univ-emerald); margin-top: 0.2rem;"><%= interviewCount %></div>
    </div>
  </a>
</div>

<!-- Applications Table (Substack Editorial Density) -->
<div class="card" style="border: 1.5px solid var(--connext-border); box-shadow: var(--shadow-card);">
  <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline);">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-voltage-lime); border: 1.5px solid var(--color-forest-abyss);"></div>
      <div style="font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; color: var(--color-forest-abyss);">
        Başvuru Akışı
      </div>
      <span class="badge" style="background: var(--color-mist-surface); color: var(--color-forest-abyss);">
        <%= totalApps %> Kayıt
      </span>
    </div>
  </div>

  <div class="card-body" style="padding: 0;">
    <% if (applications && applications.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 70px;">ID</th>
              <th>Aday / Mezun</th>
              <th>Pozisyon &amp; Şirket</th>
              <th>Durum</th>
              <th>Beklenen Maaş</th>
              <th>Tarih</th>
              <th style="text-align: right;">Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr>
                <td style="font-family: var(--font-mono); font-weight: 700; color: var(--color-stone-neutral);">
                  #<%= app.id %>
                </td>
                <td>
                  <strong style="font-family: var(--font-display); font-size: 1.05rem; color: var(--color-forest-abyss);">
                    <%= app.applicant ? (app.applicant.first_name + ' ' + app.applicant.last_name) : ('Kullanıcı #' + app.user_id) %>
                  </strong>
                  <% if (app.applicant && app.applicant.email) { %>
                    <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-stone-neutral);">
                      <%= app.applicant.email %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (app.job) { %>
                    <a href="/jobs/<%= app.job.id %>" style="color: var(--color-forest-abyss); font-weight: 700; text-decoration: none;">
                      <%= app.job.title %>
                    </a>
                    <div style="font-size: 0.84rem; color: var(--color-stone-neutral);">
                      🏢 <%= app.job.company %>
                    </div>
                  <% } else { %>
                    <span style="color: var(--color-stone-neutral);">İlan #<%= app.job_id %></span>
                  <% } %>
                </td>
                <td>
                  <% if (app.status === 'ACCEPTED') { %>
                    <span class="badge badge-verified">✓ Kabul Edildi</span>
                  <% } else if (app.status === 'INTERVIEW') { %>
                    <span class="badge" style="background: var(--color-voltage-lime); color: var(--color-forest-abyss); font-weight: 800;">🎯 Mülakat</span>
                  <% } else if (app.status === 'REVIEWING') { %>
                    <span class="badge" style="background: #e0f2fe; color: #0369a1;">👀 İnceleniyor</span>
                  <% } else if (app.status === 'REJECTED') { %>
                    <span class="badge badge-inactive">Reddedildi</span>
                  <% } else { %>
                    <span class="badge" style="background: var(--color-canary-yellow); color: #854d0e; font-weight: 700;">⏳ Beklemede</span>
                  <% } %>
                </td>
                <td style="font-family: var(--font-mono); font-weight: 600; color: var(--color-forest-abyss);">
                  <% if (app.expected_salary) { %>
                    <%= Number(app.expected_salary).toLocaleString('tr-TR') %> <%= app.currency || 'TRY' %>
                  <% } else { %>
                    <span style="color: var(--color-stone-neutral);">-</span>
                  <% } %>
                </td>
                <td style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--color-stone-neutral);">
                  <%= app.applied_at ? new Date(app.applied_at).toLocaleDateString('tr-TR') : '-' %>
                </td>
                <td style="text-align: right;">
                  <a href="/applications/<%= app.id %>" class="pill-btn pill-lime" style="padding: 0.28rem 0.8rem; font-size: 0.78rem;">
                    İncele &rarr;
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 3.5rem 1.5rem;">
        <div style="font-size: 3rem; margin-bottom: 0.75rem;">📝</div>
        <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--color-forest-abyss); margin-bottom: 0.4rem;">
          Henüz Başvuru Bulunmuyor
        </h3>
        <p style="color: var(--color-stone-neutral); font-size: 0.95rem; margin-bottom: 1.25rem;">
          Açık ilanlara başvurmak için kariyer sayfasını ziyaret edebilirsiniz.
        </p>
        <a href="/applications/new" class="pill-btn pill-lime">+ Yeni Başvuru Yap</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
