<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: #0f172a;">📝 İş ve Staj Başvuruları</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Users & JobPostings Çoka-Çok (N:M) Aksiyon Tablosu ve Değerlendirme Takibi</p>
  </div>
  <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
    <a href="/applications/new" class="btn btn-primary" style="background-color: #6366f1;">
      <span>➕</span> Yeni Başvuru Yap
    </a>
    <a href="/jobs" class="btn btn-secondary">
      <span>💼</span> İlanlara Git
    </a>
    <a href="/api/applications" target="_blank" class="btn btn-secondary">
      <span>⚡</span> REST API (JSON)
    </a>
  </div>
</div>

<!-- Filtreleme Kartı -->
<div class="card" style="margin-bottom: 1.5rem;">
  <div class="card-body" style="padding: 1rem 1.5rem;">
    <form action="/applications" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 160px;">
        <label class="form-label" for="status">Başvuru Durumu</label>
        <select id="status" name="status" class="form-select">
          <option value="">Tümü</option>
          <option value="PENDING" <%= filters && filters.status === 'PENDING' ? 'selected' : '' %>>⏳ Beklemede (PENDING)</option>
          <option value="REVIEWING" <%= filters && filters.status === 'REVIEWING' ? 'selected' : '' %>>👀 İnceleniyor (REVIEWING)</option>
          <option value="INTERVIEW" <%= filters && filters.status === 'INTERVIEW' ? 'selected' : '' %>>🎯 Mülakat (INTERVIEW)</option>
          <option value="OFFERED" <%= filters && filters.status === 'OFFERED' ? 'selected' : '' %>>💌 Teklif Yapıldı (OFFERED)</option>
          <option value="ACCEPTED" <%= filters && filters.status === 'ACCEPTED' ? 'selected' : '' %>>✅ Kabul Edildi (ACCEPTED)</option>
          <option value="REJECTED" <%= filters && filters.status === 'REJECTED' ? 'selected' : '' %>>❌ Reddedildi (REJECTED)</option>
          <option value="WITHDRAWN" <%= filters && filters.status === 'WITHDRAWN' ? 'selected' : '' %>>↩️ Geri Çekildi (WITHDRAWN)</option>
        </select>
      </div>

      <div style="flex: 1; min-width: 200px;">
        <label class="form-label" for="job_id">İş / Staj İlanı</label>
        <select id="job_id" name="job_id" class="form-select">
          <option value="">Tüm İlanlar</option>
          <% if (typeof jobs !== 'undefined' && jobs) { %>
            <% jobs.forEach(j => { %>
              <option value="<%= j.id %>" <%= filters && String(filters.job_id) === String(j.id) ? 'selected' : '' %>>
                <%= j.title %> (<%= j.company %>)
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div style="flex: 1; min-width: 180px;">
        <label class="form-label" for="user_id">Aday Kullanıcı</label>
        <select id="user_id" name="user_id" class="form-select">
          <option value="">Tüm Adaylar</option>
          <% if (typeof users !== 'undefined' && users) { %>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>" <%= filters && String(filters.user_id) === String(u.id) ? 'selected' : '' %>>
                <%= u.first_name %> <%= u.last_name %> (<%= u.email %>)
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-primary" style="background-color: #6366f1;">Filtrele</button>
        <% if (filters && (filters.status || filters.job_id || filters.user_id)) { %>
          <a href="/applications" class="btn btn-secondary">Temizle</a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Başvuru Listesi Tablosu -->
<div class="card">
  <div class="card-body" style="padding: 0;">
    <% if (applications && applications.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 60px;">#ID</th>
              <th>İş / Staj Pozisyonu</th>
              <th>Başvuran Aday</th>
              <th>Beklenen Maaş</th>
              <th>Durum</th>
              <th>Başvuru Tarihi</th>
              <th style="text-align: right;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr>
                <td><strong>#<%= app.id %></strong></td>
                <td>
                  <div style="font-weight: 600; color: #0f172a;">
                    <a href="/jobs/<%= app.job.id %>" style="color: inherit; text-decoration: none;">
                      <%= app.job.title %>
                    </a>
                  </div>
                  <div style="font-size: 0.85rem; color: var(--text-muted);">
                    🏢 <%= app.job.company %>
                  </div>
                </td>
                <td>
                  <div style="font-weight: 600; color: #0f172a;">
                    <a href="/users/<%= app.applicant.id %>" style="color: inherit; text-decoration: none;">
                      <%= app.applicant.first_name %> <%= app.applicant.last_name %>
                    </a>
                  </div>
                  <div style="font-size: 0.85rem; color: var(--text-muted);">
                    ✉️ <%= app.applicant.email %>
                  </div>
                </td>
                <td>
                  <% if (app.expected_salary) { %>
                    <span style="font-weight: 600; color: #059669;">
                      <%= Number(app.expected_salary).toLocaleString('tr-TR') %> ₺
                    </span>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Belirtilmemiş</span>
                  <% } %>
                </td>
                <td>
                  <% 
                    let badgeBg = '#f1f5f9';
                    let badgeColor = '#475569';
                    let statusLabel = app.status;

                    switch (app.status) {
                      case 'PENDING':
                        badgeBg = '#fef3c7'; badgeColor = '#92400e'; statusLabel = '⏳ Beklemede';
                        break;
                      case 'REVIEWING':
                        badgeBg = '#dbeafe'; badgeColor = '#1e40af'; statusLabel = '👀 İnceleniyor';
                        break;
                      case 'INTERVIEW':
                        badgeBg = '#ede9fe'; badgeColor = '#5b21b6'; statusLabel = '🎯 Mülakat';
                        break;
                      case 'OFFERED':
                        badgeBg = '#ccfbf1'; badgeColor = '#115e59'; statusLabel = '💌 Teklif';
                        break;
                      case 'ACCEPTED':
                        badgeBg = '#dcfce7'; badgeColor = '#166534'; statusLabel = '✅ Kabul Edildi';
                        break;
                      case 'REJECTED':
                        badgeBg = '#fee2e2'; badgeColor = '#991b1b'; statusLabel = '❌ Reddedildi';
                        break;
                      case 'WITHDRAWN':
                        badgeBg = '#f3f4f6'; badgeColor = '#6b7280'; statusLabel = '↩️ Geri Çekildi';
                        break;
                    }
                  %>
                  <span style="display: inline-block; padding: 0.35rem 0.75rem; border-radius: 9999px; font-size: 0.82rem; font-weight: 700; background-color: <%= badgeBg %>; color: <%= badgeColor %>;">
                    <%= statusLabel %>
                  </span>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted);">
                  <%= new Date(app.applied_at).toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td style="text-align: right;">
                  <div style="display: flex; gap: 0.4rem; justify-content: flex-end;">
                    <a href="/applications/<%= app.id %>" class="btn btn-secondary" style="padding: 0.35rem 0.7rem; font-size: 0.85rem;">
                      Detay / İncele
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 3rem 1.5rem;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a;">Kayıtlı Başvuru Bulunamadı</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
          Seçtiğiniz filtrelere uygun başvuru kaydı yok veya sisteme henüz başvuru yapılmamış.
        </p>
        <a href="/applications/new" class="btn btn-primary" style="background-color: #6366f1;">
          İlk Başvuruyu Oluştur
        </a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
