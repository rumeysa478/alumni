<%- include('./partials/header') %>

<div class="card" style="max-width: 680px; margin: 3rem auto; text-align: center; padding: 3.5rem 2.5rem; border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: 0 16px 36px rgba(5, 35, 38, 0.12); background: #ffffff;">
  
  <!-- School / Handshake Highlighted Eyebrow -->
  <div class="parenthetical-eyebrow" style="justify-content: center; margin-bottom: 0.75rem;">
    <span>🧭</span> (Y)our 404 guardian &middot; Navigation Safeguard
  </div>

  <!-- Big Voltage Lime & Canary Yellow 404 Numeral -->
  <div style="font-family: var(--font-display); font-size: 6rem; font-weight: 900; letter-spacing: -3px; line-height: 1; margin-bottom: 0.5rem; background: linear-gradient(135deg, var(--color-voltage-lime) 0%, var(--color-canary-yellow) 40%, var(--color-univ-emerald) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
    404
  </div>

  <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 0.75rem; color: var(--color-forest-abyss);">
    <%= typeof title !== 'undefined' ? title : 'Sayfa Bulunamadı' %>
  </h1>

  <p style="color: var(--color-warm-ink); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.25rem; max-width: 520px; margin-left: auto; margin-right: auto;">
    <% if (typeof path !== 'undefined' && path) { %>
      Aradığınız <code style="background: var(--color-mist-surface); color: var(--color-forest-abyss); padding: 3px 8px; border-radius: 6px; font-family: var(--font-mono); font-size: 0.9em; border: 1px solid var(--color-ash-hairline);"><%= path %></code> adresi bu sunucuda bulunamadı veya taşınmış olabilir.
    <% } else { %>
      Ulaşmaya çalıştığınız sayfa veya kaynak mevcut değil, taşınmış veya silinmiş olabilir.
    <% } %>
  </p>

  <!-- Reason Box with strict 'Nedeni (Reason):' format for tests -->
  <% if (typeof reason !== 'undefined' && reason) { %>
    <div style="background: #fefce8; color: #854d0e; padding: 0.95rem 1.25rem; border-radius: 12px; font-size: 0.92rem; margin: 1.25rem auto 2rem; border: 1.5px solid #fef08a; text-align: left; max-width: 540px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
      <div style="font-family: var(--font-mono); font-weight: 700; margin-bottom: 0.25rem; color: #713f12; display: flex; align-items: center; gap: 0.4rem;">
        <span>⚠️</span> <strong>Nedeni (Reason):</strong>
      </div>
      <div style="line-height: 1.5;">
        <%= reason %>
      </div>
    </div>
  <% } %>

  <!-- Helpful Action Buttons -->
  <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem;">
    <a href="/" class="pill-btn pill-lime" style="text-decoration: none;">🏠 Ana Sayfaya Dön</a>
    <a href="/jobs" class="pill-btn" style="text-decoration: none;">💼 İş &amp; Staj İlanları</a>
    <a href="/users" class="pill-btn" style="text-decoration: none;">👥 Mezunlar</a>
    <a href="/announcements" class="pill-btn" style="text-decoration: none;">📢 Duyurular</a>
  </div>

  <div style="margin-top: 2rem;">
    <button onclick="window.history.back()" style="background: none; border: none; color: var(--color-stone-neutral); font-size: 0.88rem; font-family: var(--font-mono); cursor: pointer; text-decoration: underline;">
      &larr; Bir önceki sayfaya geri dön
    </button>
  </div>

</div>

<%- include('./partials/footer') %>
