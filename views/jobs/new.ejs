<%- include('../partials/header') %>

<div style="margin-bottom: 1rem;">
  <a href="/jobs" style="color: #64748b; text-decoration: none; font-size: 0.9rem;">
    ← Tüm İlanlara Dön
  </a>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <div class="card-header">
    <h1 style="font-size: 1.4rem; font-weight: 800; color: #0f172a; margin: 0;">
      💼 Yeni İş / Staj İlanı Yayınla
    </h1>
  </div>

  <div class="card-body">
    <% if (errorMessage) { %>
      <div class="alert alert-error" style="margin-bottom: 1.5rem;">
        ⚠ <%= errorMessage %>
      </div>
    <% } %>

    <form action="/jobs" method="POST">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group">
          <label class="form-label" for="title">Pozisyon Başlığı *</label>
          <input type="text" id="title" name="title" class="form-control" placeholder="Örn: Senior Backend Engineer" value="<%= formData && formData.title ? formData.title : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="company">Firma / Kurum Adı *</label>
          <input type="text" id="company" name="company" class="form-control" placeholder="Örn: Trendyol Tech" value="<%= formData && formData.company ? formData.company : '' %>" required>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group">
          <label class="form-label" for="type">İstihdam Türü</label>
          <select id="type" name="type" class="form-select">
            <option value="FULL_TIME" <%= formData && formData.type === 'FULL_TIME' ? 'selected' : '' %>>Tam Zamanlı</option>
            <option value="PART_TIME" <%= formData && formData.type === 'PART_TIME' ? 'selected' : '' %>>Yarı Zamanlı</option>
            <option value="INTERNSHIP" <%= formData && formData.type === 'INTERNSHIP' ? 'selected' : '' %>>Staj</option>
            <option value="CONTRACT" <%= formData && formData.type === 'CONTRACT' ? 'selected' : '' %>>Sözleşmeli</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="work_model">Çalışma Modeli</label>
          <select id="work_model" name="work_model" class="form-select">
            <option value="HYBRID" <%= formData && formData.work_model === 'HYBRID' ? 'selected' : '' %>>Hibrit</option>
            <option value="REMOTE" <%= formData && formData.work_model === 'REMOTE' ? 'selected' : '' %>>Uzaktan</option>
            <option value="ONSITE" <%= formData && formData.work_model === 'ONSITE' ? 'selected' : '' %>>Ofisten</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="experience_level">Deneyim Seviyesi</label>
          <select id="experience_level" name="experience_level" class="form-select">
            <option value="INTERN" <%= formData && formData.experience_level === 'INTERN' ? 'selected' : '' %>>Stajyer</option>
            <option value="ENTRY_LEVEL" <%= formData && formData.experience_level === 'ENTRY_LEVEL' ? 'selected' : '' %>>Yeni Mezun</option>
            <option value="JUNIOR" <%= formData && formData.experience_level === 'JUNIOR' ? 'selected' : '' %>>Junior (1-2 Yıl)</option>
            <option value="MID" <%= (!formData || !formData.experience_level || formData.experience_level === 'MID') ? 'selected' : '' %>>Mid-Level (3-5 Yıl)</option>
            <option value="SENIOR" <%= formData && formData.experience_level === 'SENIOR' ? 'selected' : '' %>>Senior (5+ Yıl)</option>
            <option value="LEAD" <%= formData && formData.experience_level === 'LEAD' ? 'selected' : '' %>>Lead</option>
          </select>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group">
          <label class="form-label" for="location">Konum / Şehir</label>
          <input type="text" id="location" name="location" class="form-control" placeholder="Örn: İstanbul (Maslak)" value="<%= formData && formData.location ? formData.location : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="sector">Sektör</label>
          <input type="text" id="sector" name="sector" class="form-control" placeholder="Örn: Yazılım & Bilişim" value="<%= formData && formData.sector ? formData.sector : '' %>">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 1rem;">
        <label class="form-label" for="description">Pozisyon Tanımı ve Görevler *</label>
        <textarea id="description" name="description" class="form-control" rows="4" placeholder="İlan detayları..." required><%= formData && formData.description ? formData.description : '' %></textarea>
      </div>

      <div class="form-group" style="margin-bottom: 1rem;">
        <label class="form-label" for="requirements">Aranan Nitelikler & Şartlar</label>
        <textarea id="requirements" name="requirements" class="form-control" rows="3" placeholder="Teknolojiler, eğitim şartı, yabancı dil..."><%= formData && formData.requirements ? formData.requirements : '' %></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group">
          <label class="form-label" for="salary_min">Min. Maaş (TRY)</label>
          <input type="number" id="salary_min" name="salary_min" class="form-control" placeholder="45000" value="<%= formData && formData.salary_min ? formData.salary_min : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="salary_max">Maks. Maaş (TRY)</label>
          <input type="number" id="salary_max" name="salary_max" class="form-control" placeholder="65000" value="<%= formData && formData.salary_max ? formData.salary_max : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="deadline">Son Başvuru Tarihi</label>
          <input type="date" id="deadline" name="deadline" class="form-control" value="<%= formData && formData.deadline ? formData.deadline.substring(0, 10) : '' %>">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
        <div class="form-group">
          <label class="form-label" for="application_url">Harici Başvuru URL</label>
          <input type="url" id="application_url" name="application_url" class="form-control" placeholder="https://careers.company.com/..." value="<%= formData && formData.application_url ? formData.application_url : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="posted_by">İlan Sahibi Mezun</label>
          <select id="posted_by" name="posted_by" class="form-select">
            <option value="">-- Mezun / Yetkili Seçin --</option>
            <% if (typeof users !== 'undefined' && users) { %>
              <% users.forEach(u => { %>
                <option value="<%= u.id %>" <%= formData && formData.posted_by == u.id ? 'selected' : '' %>><%= u.first_name %> <%= u.last_name %> (<%= u.role %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>
      </div>

      <div style="display: flex; gap: 0.75rem;">
        <button type="submit" class="btn btn-primary" style="background-color: #0284c7;">✓ İlanı Yayınla</button>
        <a href="/jobs" class="btn btn-secondary">İptal</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
