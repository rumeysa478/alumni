<%- include('../partials/header') %>

<div style="max-width: 800px; margin: 0 auto 3rem;">
  <div style="margin-bottom: 1.5rem;">
    <div class="parenthetical-eyebrow">
      <span>(Y)our</span> career posting &middot; Recruitment Desk
    </div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem;">
      <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; color: var(--color-forest-abyss); margin: 0;">
        💼 Yeni İş / Staj İlanı Yayınla
      </h1>
      <a href="/jobs" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Tüm İlanlara Dön
      </a>
    </div>
    <p style="color: var(--color-warm-ink); font-size: 0.95rem; margin-top: 0.4rem;">
      İstanbul Üniversitesi mezunları ve öğrencileri için açık pozisyon veya staj fırsatı oluşturun.
    </p>
  </div>

  <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-hover);">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.25rem 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem;">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--color-voltage-lime); border: 1.5px solid var(--color-forest-abyss);"></div>
        <div style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--color-forest-abyss);">
          İlan Detayları
        </div>
      </div>
      <div style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-stone-neutral);">
        * Zorunlu Alanlar &bull; Maks. 120 Karakter Başlık
      </div>
    </div>

    <div class="card-body" style="padding: 2rem;">
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="alert alert-error" style="margin-bottom: 1.5rem;">
          ⚠ <%= errorMessage %>
        </div>
      <% } %>

      <form action="/jobs" method="POST">
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="title">Pozisyon Başlığı * (Maks. 120 Karakter)</label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-control"
              placeholder="Örn: Junior Backend Developer"
              maxlength="120"
              value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
              required
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="company">Firma / Kurum Adı *</label>
            <input
              type="text"
              id="company"
              name="company"
              class="form-control"
              placeholder="Örn: Trendyol Tech"
              value="<%= typeof formData !== 'undefined' && formData.company ? formData.company : '' %>"
              required
            >
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="type">İstihdam Türü</label>
            <select id="type" name="type" class="form-select">
              <option value="FULL_TIME" <%= typeof formData !== 'undefined' && formData.type === 'FULL_TIME' ? 'selected' : '' %>>Tam Zamanlı</option>
              <option value="PART_TIME" <%= typeof formData !== 'undefined' && formData.type === 'PART_TIME' ? 'selected' : '' %>>Yarı Zamanlı</option>
              <option value="INTERNSHIP" <%= typeof formData !== 'undefined' && formData.type === 'INTERNSHIP' ? 'selected' : '' %>>Staj</option>
              <option value="CONTRACT" <%= typeof formData !== 'undefined' && formData.type === 'CONTRACT' ? 'selected' : '' %>>Sözleşmeli</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="work_model">Çalışma Modeli</label>
            <select id="work_model" name="work_model" class="form-select">
              <option value="HYBRID" <%= typeof formData !== 'undefined' && formData.work_model === 'HYBRID' ? 'selected' : '' %>>Hibrit</option>
              <option value="REMOTE" <%= typeof formData !== 'undefined' && formData.work_model === 'REMOTE' ? 'selected' : '' %>>Uzaktan (Remote)</option>
              <option value="ONSITE" <%= typeof formData !== 'undefined' && formData.work_model === 'ONSITE' ? 'selected' : '' %>>Ofisten (Onsite)</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="experience_level">Deneyim Seviyesi</label>
            <select id="experience_level" name="experience_level" class="form-select">
              <option value="INTERN" <%= typeof formData !== 'undefined' && formData.experience_level === 'INTERN' ? 'selected' : '' %>>Stajyer</option>
              <option value="ENTRY_LEVEL" <%= typeof formData !== 'undefined' && formData.experience_level === 'ENTRY_LEVEL' ? 'selected' : '' %>>Yeni Mezun</option>
              <option value="MID_LEVEL" <%= typeof formData !== 'undefined' && formData.experience_level === 'MID_LEVEL' ? 'selected' : '' %>>Orta Seviye</option>
              <option value="SENIOR" <%= typeof formData !== 'undefined' && formData.experience_level === 'SENIOR' ? 'selected' : '' %>>Kıdemli (Senior)</option>
            </select>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="location">Şehir / Lokasyon</label>
            <input
              type="text"
              id="location"
              name="location"
              class="form-control"
              placeholder="Örn: İstanbul / Maslak"
              value="<%= typeof formData !== 'undefined' && formData.location ? formData.location : '' %>"
            >
          </div>

          <div class="form-group">
            <label class="form-label" for="posted_by">İlanı Veren Mezun / Yetkili</label>
            <select id="posted_by" name="posted_by" class="form-select">
              <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.email %>)</option>
                <% }); %>
              <% } else { %>
                <option value="1">Sistem Yöneticisi</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">İlan Açıklaması ve Aranan Nitelikler</label>
          <textarea
            id="description"
            name="description"
            rows="5"
            class="form-control"
            placeholder="Pozisyonun sorumlulukları, teknoloji yığını ve adaydan beklenen yetkinlikler..."
          ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
        </div>

        <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
          <a href="/jobs" class="pill-btn" style="background: var(--color-mist-surface);">İptal</a>
          <button type="submit" class="pill-btn pill-lime">
            ✓ İlanı Yayınla
          </button>
        </div>

      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
