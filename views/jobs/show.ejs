<%- include('../partials/header') %>

<div style="margin-bottom: 1.25rem;">
  <a href="/jobs" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
    &larr; Tüm İlanlara Dön
  </a>
</div>

<div class="card" style="border: 2px solid var(--connext-border); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.06); margin-bottom: 1.75rem;">
  <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border); padding: 1.5rem 2rem;">
    <div>
      <div style="display: flex; gap: 0.5rem; margin-bottom: 0.4rem; flex-wrap: wrap;">
        <span class="badge" style="background-color: #e0f2fe; color: #0369a1;"><%= job.type %></span>
        <span class="badge" style="background-color: #f3e8ff; color: #6b21a8;"><%= job.work_model %></span>
        <% if (job.is_active) { %>
          <span class="badge badge-active">Açık Pozisyon</span>
        <% } else { %>
          <span class="badge badge-inactive">Kapandı</span>
        <% } %>
      </div>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 2.2rem; font-weight: 800; color: #111; margin: 0 0 0.3rem 0;">
        <%= job.title %>
      </h1>
      <div style="color: #64748b; font-size: 1.05rem;">
        🏢 <strong><%= job.company %></strong> &nbsp;•&nbsp; 📍 <%= job.location || 'Konum belirtilmedi' %>
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/jobs/<%= job.id %>/edit" class="pill-btn pill-peach">Düzenle</a>
      <form action="/jobs/<%= job.id %>/delete" method="POST" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz?');" style="display: inline;">
        <button type="submit" class="pill-btn" style="background: #fee2e2; color: #b91c1c; border-color: #f87171;">Sil</button>
      </form>
    </div>
  </div>

  <div class="card-body" style="padding: 2rem;">
    <div style="background-color: #fafafa; border: 1px solid #e5e7eb; padding: 1.25rem; border-radius: 12px; margin-bottom: 1.75rem; display: flex; gap: 2.5rem; flex-wrap: wrap;">
      <div>
        <span style="color: #64748b; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">Maaş Skalası</span><br>
        <strong style="font-size: 1.15rem; color: #111;">
          <% if (job.salary_min && job.salary_max) { %>
            <%= Number(job.salary_min).toLocaleString('tr-TR') %> - <%= Number(job.salary_max).toLocaleString('tr-TR') %> <%= job.currency || 'TRY' %>
          <% } else { %>
            Görüşmede Belirlenecek
          <% } %>
        </strong>
      </div>
      <div>
        <span style="color: #64748b; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">İlan Sahibi</span><br>
        <strong style="font-size: 1.15rem; color: #111;"><%= poster ? (poster.first_name + ' ' + poster.last_name) : 'Sistem / Mezun' %></strong>
      </div>
      <div>
        <span style="color: #64748b; font-size: 0.85rem; font-weight: 700; text-transform: uppercase;">Toplam Başvuru</span><br>
        <strong style="font-size: 1.15rem; color: #111;">👥 <%= applicants ? applicants.length : 0 %> Aday</strong>
      </div>
    </div>

    <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.35rem; font-weight: 800; color: #111; margin-bottom: 0.5rem;">İş Tanımı ve Kapsamı</h3>
    <p style="color: #334155; line-height: 1.7; margin-bottom: 1.5rem; white-space: pre-line;">
      <%= job.description %>
    </p>

    <% if (job.requirements) { %>
      <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.35rem; font-weight: 800; color: #111; margin-bottom: 0.5rem;">Aranan Nitelikler</h3>
      <p style="color: #334155; line-height: 1.7; margin-bottom: 1.5rem; white-space: pre-line;">
        <%= job.requirements %>
      </p>
    <% } %>
  </div>
</div>

<!-- Başvuru Formu (N:M İlişki) -->
<div class="card" style="border: 2px solid var(--connext-border); border-radius: 16px; margin-bottom: 1.75rem;">
  <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border); padding: 1.25rem 2rem;">
    <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; font-weight: 800; margin: 0;">🚀 Bu İlana Başvuru Yap</h3>
    <a href="/applications/new?job_id=<%= job.id %>" class="pill-btn pill-pink" style="font-size: 0.82rem; padding: 0.3rem 0.85rem;">
      Tam Sayfa Başvuru Formu &rarr;
    </a>
  </div>
  <div class="card-body" style="padding: 2rem;">
    <form action="/jobs/<%= job.id %>/apply" method="POST">
      <div class="form-group">
        <label class="form-label" for="user_id">Başvuran Kullanıcıyı Seçin *</label>
        <select id="user_id" name="user_id" class="form-select" required>
          <option value="">-- Başvuran Kullanıcı Seçin --</option>
          <% if (typeof allUsers !== 'undefined' && allUsers) { %>
            <% allUsers.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.first_name %> <%= u.last_name %> (<%= u.role %> - <%= u.department || 'MIS' %>)</option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="cover_letter">Ön Yazı / Motivasyon Notu</label>
        <textarea id="cover_letter" name="cover_letter" class="form-control" rows="3" placeholder="Pozisyona ilgi ve yetkinliklerinizi kısaca özetleyin..."></textarea>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.25rem;">
        <div>
          <label class="form-label" for="resume_url">Özgeçmiş / CV Linki</label>
          <input type="text" id="resume_url" name="resume_url" class="form-control" placeholder="https://linkedin.com/in/... veya CV linki">
        </div>

        <div>
          <label class="form-label" for="portfolio_url">Portfolyo / GitHub Linki</label>
          <input type="text" id="portfolio_url" name="portfolio_url" class="form-control" placeholder="https://github.com/... veya web sitesi">
        </div>

        <div>
          <label class="form-label" for="expected_salary">Beklenen Aylık Net Maaş (TRY)</label>
          <input type="number" id="expected_salary" name="expected_salary" class="form-control" placeholder="Örn: 65000" min="0" step="1000">
        </div>
      </div>

      <button type="submit" class="pill-btn pill-pink" style="font-size: 0.95rem; padding: 0.6rem 1.75rem;">
        ✓ Başvurumu İlet
      </button>
    </form>
  </div>
</div>

<!-- Mevcut Başvuranlar Tablosu -->
<% if (applicants && applicants.length > 0) { %>
  <div class="card" style="border: 1.5px solid var(--connext-border); border-radius: 16px;">
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--connext-border); padding: 1.25rem 2rem;">
      <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; font-weight: 800; margin: 0;">
        👥 Bu İlana Yapılan Başvurular (<%= applicants.length %>)
      </h3>
    </div>
    <div class="card-body" style="padding: 0;">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Aday</th>
              <th>E-Posta</th>
              <th>Durum</th>
              <th>Başvuru Tarihi</th>
              <th style="text-align: right;">Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% applicants.forEach(app => { %>
              <tr>
                <td>
                  <a href="/users/<%= app.user_id %>" style="color: #111; font-weight: 700; text-decoration: none;">
                    <%= app.first_name %> <%= app.last_name %>
                  </a>
                </td>
                <td style="font-size: 0.9rem; color: #475569;"><%= app.email %></td>
                <td>
                  <span class="badge" style="background-color: #fef3c7; color: #92400e;"><%= app.status %></span>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted);">
                  <%= app.applied_at ? new Date(app.applied_at).toLocaleString('tr-TR') : '-' %>
                </td>
                <td style="text-align: right;">
                  <a href="/applications/<%= app.application_id || app.id %>" class="pill-btn pill-peach" style="font-size: 0.8rem; padding: 0.2rem 0.65rem;">
                    İncele ↗
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
