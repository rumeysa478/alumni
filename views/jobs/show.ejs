<%- include('../partials/header') %>

<div style="max-width: 900px; margin: 0 auto 3rem;">
  
  <!-- Back Link & Top Bar Actions -->
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> job dossier &middot; Career Opportunity
      </div>
      <a href="/jobs" class="pill-btn" style="font-size: 0.82rem; padding: 0.35rem 0.9rem;">
        &larr; Tüm İlanlara Dön
      </a>
    </div>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <a href="/jobs/<%= job.id %>/edit" class="pill-btn pill-yellow" style="font-size: 0.85rem;">
        ✏️ İlanı Düzenle
      </a>
      <form action="/jobs/<%= job.id %>/delete" method="POST" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz?');" style="display: inline;">
        <button type="submit" class="pill-btn btn-danger" style="font-size: 0.85rem; padding: 0.45rem 1rem;">
          🗑️ Sil
        </button>
      </form>
    </div>
  </div>

  <!-- Job Main Card -->
  <div class="card" style="border: 2px solid var(--color-forest-abyss); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-hover); overflow: hidden; margin-bottom: 2rem;">
    
    <div class="card-header" style="background: #ffffff; border-bottom: 1.5px solid var(--color-ash-hairline); padding: 1.75rem 2.25rem;">
      <div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.6rem; flex-wrap: wrap;">
          <span class="badge" style="background: var(--color-voltage-lime); color: var(--color-forest-abyss); font-weight: 800;">
            <%= job.type %>
          </span>
          <span class="badge" style="background: var(--color-forest-abyss); color: #ffffff;">
            <%= job.work_model %>
          </span>
          <% if (job.is_active) { %>
            <span class="badge badge-verified">✓ Açık Pozisyon</span>
          <% } else { %>
            <span class="badge badge-inactive">Kapandı</span>
          <% } %>
        </div>

        <h1 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 900; color: var(--color-forest-abyss); margin: 0 0 0.4rem 0; line-height: 1.2;">
          <%= job.title %>
        </h1>

        <div style="color: var(--color-warm-ink); font-size: 1.05rem;">
          🏢 <strong><%= job.company %></strong> &nbsp;&bull;&nbsp; 📍 <%= job.location || 'Konum belirtilmedi' %>
        </div>
      </div>

      <div>
        <a href="/applications/new?job_id=<%= job.id %>" class="pill-btn pill-lime" style="padding: 0.6rem 1.6rem; font-size: 0.95rem;">
          ⚡ Hemen Başvur &rarr;
        </a>
      </div>
    </div>

    <div class="card-body" style="padding: 2.25rem;">
      
      <!-- SpatialChat 2x3 Metric Strip -->
      <div style="background-color: #fbfcfb; border: 1.5px solid var(--color-ash-hairline); padding: 1.5rem; border-radius: 14px; margin-bottom: 2rem; display: flex; gap: 2.5rem; flex-wrap: wrap;">
        <div>
          <span style="font-family: var(--font-mono); color: var(--color-stone-neutral); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Maaş Skalası</span><br>
          <strong style="font-size: 1.15rem; color: var(--color-forest-abyss);">
            <% if (job.salary_min && job.salary_max) { %>
              <%= Number(job.salary_min).toLocaleString('tr-TR') %> - <%= Number(job.salary_max).toLocaleString('tr-TR') %> <%= job.currency || 'TRY' %>
            <% } else { %>
              Görüşmede Belirlenecek
            <% } %>
          </strong>
        </div>

        <div>
          <span style="font-family: var(--font-mono); color: var(--color-stone-neutral); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">İlan Sahibi</span><br>
          <strong style="font-size: 1.15rem; color: var(--color-forest-abyss);">
            <%= poster ? (poster.first_name + ' ' + poster.last_name) : 'Sistem / Mezun' %>
          </strong>
        </div>

        <div>
          <span style="font-family: var(--font-mono); color: var(--color-stone-neutral); font-size: 0.78rem; font-weight: 700; text-transform: uppercase;">Toplam Başvuru</span><br>
          <strong style="font-size: 1.15rem; color: var(--color-univ-emerald);">
            👥 <%= applicants ? applicants.length : 0 %> Aday Başvurdu
          </strong>
        </div>
      </div>

      <!-- Description -->
      <div class="parenthetical-eyebrow">
        <span>(Y)our</span> job scope &middot; Specifications
      </div>
      <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 800; color: var(--color-forest-abyss); margin-bottom: 0.75rem;">
        Pozisyon Tanımı ve Beklentiler
      </h3>
      <div style="font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.8; color: var(--color-warm-ink); white-space: pre-line; margin-bottom: 2rem;">
        <%= job.description %>
      </div>

      <!-- Action Footer -->
      <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-ash-hairline); padding-top: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <a href="/jobs" class="pill-btn" style="background: var(--color-mist-surface);">
          &larr; Diğer İlanlara Göz At
        </a>
        <a href="/applications/new?job_id=<%= job.id %>" class="pill-btn pill-lime">
          Bu Pozisyona Başvur &rarr;
        </a>
      </div>

    </div>

  </div>

  <!-- Applicants list for this job -->
  <% if (typeof applicants !== 'undefined' && applicants && applicants.length > 0) { %>
    <div class="card" style="border: 1.5px solid var(--connext-border);">
      <div class="card-header" style="background: #ffffff;">
        <div style="font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--color-forest-abyss);">
          Aday Havuzu (<%= applicants.length %>)
        </div>
        <a href="/applications?job_id=<%= job.id %>" class="pill-btn" style="font-size: 0.78rem; padding: 0.25rem 0.75rem;">
          Tümünü Gör
        </a>
      </div>
      <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Aday</th>
                <th>Başvuru Durumu</th>
                <th>Beklenen Maaş</th>
                <th>Tarih</th>
                <th style="text-align: right;">Detay</th>
              </tr>
            </thead>
            <tbody>
              <% applicants.forEach(app => { %>
                <tr>
                  <td>
                    <strong><%= app.applicant ? (app.applicant.first_name + ' ' + app.applicant.last_name) : ('Kullanıcı #' + app.user_id) %></strong>
                  </td>
                  <td>
                    <span class="badge" style="background: var(--color-voltage-lime); color: var(--color-forest-abyss); font-weight: 700;">
                      <%= app.status %>
                    </span>
                  </td>
                  <td style="font-family: var(--font-mono);">
                    <%= app.expected_salary ? Number(app.expected_salary).toLocaleString('tr-TR') + ' ' + (app.currency || 'TRY') : '-' %>
                  </td>
                  <td style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-stone-neutral);">
                    <%= app.applied_at ? new Date(app.applied_at).toLocaleDateString('tr-TR') : '-' %>
                  </td>
                  <td style="text-align: right;">
                    <a href="/applications/<%= app.id %>" class="pill-btn pill-yellow" style="padding: 0.25rem 0.65rem; font-size: 0.76rem;">
                      İncele
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

</div>

<%- include('../partials/footer') %>
